// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Server {
  id          Int    @id @default(autoincrement())
  uuid        String @unique @default(uuid()) @db.Uuid
  guild_id    String @unique @db.VarChar(20)
  name        String @db.VarChar(100)
  description String?
  link        String?
  category    String? @db.VarChar(20)
  country     String? @db.VarChar(5)
  icon        String?
  banner      String?
  status      String @db.VarChar(20)
  user        User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  created_at  DateTime @default(now())

  serverStats Server_Stats?
  score       Score?
  critics     Critic[]
  tags        ServerHasTag[]

  @@map("server")
}

enum Status {
  member
  moderator
  admin
}

model User {
  id         Int    @id @default(autoincrement())
  uuid       String @unique @default(uuid()) @db.Uuid
  discord_id String @unique @db.VarChar(20)
  pseudo     String @db.VarChar(50)
  avatar     String
  role       Role   @default(member)

  servers    Server[]
  critics    Critic[]
  modActions Mod_Action[]
  reports    Report[]

  @@map("user")
}

enum Role {
  member
  moderator
  admin
}

model Server_Stats {
  id           Int      @id @default(autoincrement())
  server_bump  Boolean  @default(false)
  last_bump_at DateTime?
  users_nb     Int
  created_at   DateTime @default(now())

  server    Server @relation(fields: [server_id], references: [id], onDelete: Cascade)
  server_id Int    @unique

  @@map("server_stats")
}

model Score {
  id           Int    @id @default(autoincrement())
  uuid         String @unique @default(uuid()) @db.Uuid
  total_score  Int
  completitude Int
  activity     Int
  conformity   Int
  critic       Int

  server    Server @relation(fields: [server_id], references: [id], onDelete: Cascade)
  server_id Int    @unique

  @@map("score")
}

model Critic {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Uuid
  comment    String
  rate       Int
  status     String   @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  server    Server @relation(fields: [server_id], references: [id], onDelete: Cascade)
  server_id Int

  user    User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id Int?

  reports Report[]

  @@unique([server_id, user_id])
  @@map("critic")
}

model Mod_Action {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.Uuid
  action     String   @db.VarChar(30)
  reason     String
  target     String   @db.VarChar(36)
  type       String   @db.VarChar(30)
  created_at DateTime @default(now())

  user    User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id Int?

  @@map("mod_action")
}

model Tag {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid
  name String @db.VarChar(20)
  slug String @db.VarChar(20)

  servers ServerHasTag[]

  @@map("tag")
}

model Report {
  user        User     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  user_uuid   String   @map("user_uuid") @db.Uuid
  critic      Critic   @relation(fields: [critic_uuid], references: [uuid], onDelete: Cascade)
  critic_uuid String   @map("critic_uuid") @db.Uuid
  reason      String   @db.VarChar(255)
  created_at  DateTime @default(now())

  @@id([user_uuid, critic_uuid])
  @@map("report")
}

model ServerHasTag {
  server      Server @relation(fields: [server_uuid], references: [uuid], onDelete: Cascade)
  server_uuid String @map("server_uuid") @db.Uuid
  tag         Tag    @relation(fields: [tag_uuid], references: [uuid], onDelete: Cascade)
  tag_uuid    String @map("tag_uuid") @db.Uuid

  @@id([server_uuid, tag_uuid])
  @@map("server_tag")
}
