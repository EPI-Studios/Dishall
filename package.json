{
  "name": "dishall-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:db": "node test/run-with-env.mjs prisma migrate deploy --config prisma7.config.ts",
    "test:server": "node test/run-with-env.mjs next dev -p 3100",
    "test:api": "node test/run-with-env.mjs tsx --test --test-concurrency=1 \"test/api/*.test.ts\""
  },
  "dependencies": {
    "@iconify/react": "^6.0.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "jsonwebtoken": "^9.0.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
